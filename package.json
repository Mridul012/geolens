{
  "name": "vryse-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/http/server.ts",
    "dev:worker:browser": "tsx watch src/workers/browser.entry.ts",
    "dev:worker:ai": "tsx watch src/workers/ai.entry.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/http/server.js",
    "start:worker:browser": "node dist/workers/browser.entry.js",
    "start:worker:ai": "node dist/workers/ai.entry.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "evals:golden": "tsx evals/run-golden.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "@bull-board/api": "^6.21.3",
    "@bull-board/fastify": "^6.21.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/swagger": "^9.4.2",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.0.0",
    "better-auth": "^1.4.6",
    "bullmq": "^5.34.0",
    "cheerio": "^1.0.0",
    "crawlee": "^3.13.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^4.0.2",
    "groq-sdk": "^0.9.0",
    "ioredis": "^5.4.2",
    "langfuse": "^3.37.0",
    "openai": "^4.80.0",
    "pino": "^9.14.0",
    "playwright": "^1.49.1",
    "resend": "^4.1.1",
    "stripe": "^17.5.0",
    "tldts": "^6.1.71",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.19.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "stream-json": "^3.6.0",
    "@fastify/static": "^10.1.3",
    "deepmerge-ts": "^8.0.2"
  }
}
