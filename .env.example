# ─── Process ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HEALTH_PORT_WORKER_BROWSER=3001
HEALTH_PORT_WORKER_AI=3002
LOG_LEVEL=debug

# ─── Observability ──────────────────────────────────────────────────────────
# Optional: errors are simply not reported when unset.
SENTRY_DSN=

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vryse:vryse@localhost:5432/vryse
# Optional: unpooled endpoint used by `prisma migrate`.
DIRECT_DATABASE_URL=
DATABASE_LOG_QUERIES=false

# Dedicated database for the integration suites (falls back to DATABASE_URL).
TEST_DATABASE_URL=postgresql://vryse:vryse@localhost:5432/vryse_test

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── HTTP surface ───────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:3000
# The web/ (Next.js) app's origin. Was 3001, which collides with
# HEALTH_PORT_WORKER_BROWSER's default — web/ runs on 3005 instead.
APP_BASE_URL=http://localhost:3005
# Comma-separated; APP_BASE_URL is always allowed in addition to these.
CORS_ORIGINS=

# ─── Auth ───────────────────────────────────────────────────────────────────
# 32+ chars. Generate with: openssl rand -base64 48
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_DOMAIN=
# Optional: Google OAuth is simply unavailable when unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Object storage (MinIO locally, Cloudflare R2 in production) ────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=vryse-local
STORAGE_ACCESS_KEY_ID=vryse
STORAGE_SECRET_ACCESS_KEY=vryse-local-secret
STORAGE_FORCE_PATH_STYLE=true

# ─── Crawler ────────────────────────────────────────────────────────────────
CRAWLER_USER_AGENT=VryseBot/1.0 (+https://vryse.example/bot; AI visibility analytics)
CRAWLER_MAX_CONCURRENCY=3
CRAWLER_DELAY_MS=500
CRAWLER_PAGE_TIMEOUT_MS=30000
CRAWLER_TIME_BUDGET_MS=720000

# ─── AI providers ───────────────────────────────────────────────────────────
# "fake" runs the entire pipeline deterministically with no keys and no spend — the
# default for local development and CI. Set to "live" once you have keys.
AI_PROVIDER_MODE=fake
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Spend ceilings in micro-USD (PRD: <=$0.50 per crawl, <=$0.30 per run).
AI_BUDGET_PER_CRAWL_MICROS=500000
AI_BUDGET_PER_RUN_MICROS=300000
# Trending-cost ceiling per project per rolling month; the budget monitor flags above it.
AI_BUDGET_PER_PROJECT_MONTHLY_MICROS=5000000

# Langfuse tracing. Unset means no traces.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# "fake" records every send in memory — no key and no inbox needed locally or in CI.
EMAIL_PROVIDER_MODE=fake
RESEND_API_KEY=
EMAIL_FROM=notifications@vryse.example
# Failed-job sweeper and budget-monitor alerts. Unset means "log only, no email".
OPS_ALERT_EMAIL=

# ─── Billing (Stripe) ───────────────────────────────────────────────────────
# "fake" skips Stripe entirely: checkout/portal return synthetic URLs, and the webhook
# accepts a BillingEvent literal as its body instead of a signed Stripe envelope.
STRIPE_MODE=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The PRO plan's recurring Price id — there is only one paid price at launch.
STRIPE_PRO_PRICE_ID=

# ─── Admin ──────────────────────────────────────────────────────────────────
# Bull Board (queue visibility). Leave unset to disable the route entirely.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_EXPENSIVE_PER_MINUTE=5
